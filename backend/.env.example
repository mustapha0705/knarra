# Copy to backend/.env and fill in. Never commit .env.
#
# PostgreSQL connection for project save and reopen (M4).
# Create the database first, for example:  createdb -U postgres knarra
# Without this the server still starts; /api/projects answers 503.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/knarra

# Optional: an EMPTY scratch database for running the persistence tests
# against a real server. The tests drop and recreate its tables.
# TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/knarra_test
